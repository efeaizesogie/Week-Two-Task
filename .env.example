# ============================================================
# RFPilot — environment template
# Copy to .env and fill. Never commit real secrets.
# ============================================================

# ---- Core -------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database (Neon / local Postgres w/ pgvector) --------
# Pooled (for app runtime)
DATABASE_URL=postgresql://rfpilot:rfpilot@localhost:5432/rfpilot?schema=public
# Direct (for migrations)
DIRECT_URL=postgresql://rfpilot:rfpilot@localhost:5432/rfpilot?schema=public

# ---- Redis (Upstash or local) -----------------------------
REDIS_URL=redis://localhost:6379

# ---- Clerk Auth -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
CLERK_JWT_ISSUER=https://your-clerk-frontend-api

# ---- Stripe -----------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_TEAM=price_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- OpenAI -----------------------------------------------
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_EMBED=text-embedding-3-small

# ---- AWS S3 (uploads) -------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
S3_BUCKET=rfpilot-dev
S3_BUCKET_REGION=us-east-1

# ---- Observability ----------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# ---- Feature flags ----------------------------------------
ENABLE_SIGNUPS=true
